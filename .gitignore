# benchmarks: regenerated/local artifacts (recovered datasets under
# examples/benchmarks/data/ are tracked explicitly and unaffected by these)
examples/benchmarks/baselines/batchthneed_fig8_results.pkl
examples/benchmarks/baselines/sqpcpu_env.sh
examples/benchmarks/data/benchmark_fig8_*.pkl
examples/benchmarks/data/benchmark_stats*.pkl
examples/benchmarks/data/stale_L7_frame_pre20260730/*.pkl
examples/benchmarks/night_logs/

# paper-figures: regenerated data + rendered figures are artifacts (recovered/
# bundled datasets live elsewhere, e.g. examples/gato_hparam_batch_results.pkl)
examples/paper-figures/data/*.pkl
examples/paper-figures/data/stale_L7_frame_pre20260730/*.pkl
examples/paper-figures/*.png
examples/paper-figures/*.txt

# local task/runbook files — not tracked
docs/open-tasks/

# python bytecode caches
__pycache__/
examples/paper-figures/overnight_logs/

# bdsv timing session module stashes (rebuilt artifacts)
examples/benchmarks/data/bdsv_timing/so_*/
examples/benchmarks/data/constraint_eval/
