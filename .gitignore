# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

*.pyc

# Ignore build directories (CMake module-matrix builds: build, build_val, build_iiwa64, ...)
/build/
/build_*/

# Ignore CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

.vscode/

python/gato.egg-info/

.venv/
uv.lock

deprecated/

# benchmarks: regenerated/local artifacts (recovered datasets under
# examples/benchmarks/data/ are tracked explicitly and unaffected by these)
examples/benchmarks/baselines/batchthneed_fig8_results.pkl
examples/benchmarks/baselines/sqpcpu_env.sh
examples/benchmarks/data/benchmark_fig8_*.pkl
examples/benchmarks/data/benchmark_stats*.pkl
examples/benchmarks/data/**/*.pkl
examples/benchmarks/night_logs/

# paper-figures: regenerated data + rendered figures are artifacts (recovered/
# bundled datasets live elsewhere, e.g. examples/gato_hparam_batch_results.pkl)
# NOTE: these are recursive (**) on purpose — a rotation into a stale_*/ subdir
# used to escape the flat patterns and dirty the tree, failing the receipt's
# clean-tree check (hit at the L7 rotation, again at the Drake-swap rotation).
# READMEs in those dirs stay tracked: they carry the do-not-mix rule.
examples/paper-figures/data/**/*.pkl
examples/paper-figures/data/**/*.png
examples/paper-figures/data/**/*.txt
examples/paper-figures/*.png
examples/paper-figures/*.txt

# local task/runbook files — not tracked
docs/open-tasks/

# python bytecode caches
__pycache__/
examples/paper-figures/overnight_logs/

# bdsv timing session module stashes (rebuilt artifacts)
examples/benchmarks/data/bdsv_timing/so_*/
examples/benchmarks/data/constraint_eval/
examples/benchmarks/data/bdsv_timing/session_run_*.log
examples/benchmarks/data/bdsv_timing/so_orig/
night_logs/
