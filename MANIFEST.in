# sdist contains GATO-owned build sources, not a standalone native build:
# pinned external GRiD/GLASS trees are not bundled. Use an initialized Git
# checkout to build solver modules. Built .so modules are never packaged.
include CMakeLists.txt LICENSE README.md CHANGELOG.md CITATION.cff pyproject.toml
recursive-include docs *.md
prune docs/open-tasks
recursive-include gato *.cuh *.h *.cu
recursive-include python *.cu
recursive-include tools *.py *.sh
recursive-include test *.py *.txt *.yaml *.cu *.cuh *.json
recursive-include examples/indy7_description *
recursive-include examples/iiwa_description *
global-exclude *.so *.pyc __pycache__
