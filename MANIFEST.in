# sdist contains GATO-owned build sources, not a standalone native build: the
# GRiD code generator and the GLASS/collision headers come from the pinned
# grid-rbd wheel at build time. Built .so modules are never packaged.
include CMakeLists.txt LICENSE README.md CHANGELOG.md CITATION.cff pyproject.toml setup.py _build_resources.py
recursive-include docs *.md
prune docs/open-tasks
recursive-include gato *.cuh *.h *.cu
recursive-include python *.cu
recursive-include tools *.py *.sh
recursive-include test *.py *.txt *.yaml *.cu *.cuh *.json
recursive-include examples/indy7_description *
recursive-include examples/iiwa_description *
recursive-include examples/go2_description *
recursive-include examples/cpp *
global-exclude *.so *.pyc __pycache__
