[submodule "external/GRiD"]
	path = external/GRiD
	url = https://github.com/A2R-Lab/GRiD.git
	branch = modernizing-tests
[submodule "external/GLASS"]
	path = external/GLASS
	url = https://github.com/A2R-Lab/GLASS.git
	branch = main
[submodule "baselines/sqpcpu"]
	path = examples/benchmarks/baselines/sqpcpu
	url = https://github.com/EmreAdabag/sqpcpu
	# OPT-IN research baseline (paper Fig-3 CPU arm). The pinned commit carries
	# the fair-comparison patches (fig3-fair-sigma) and is NOT on the upstream
	# URL — it lives on a private fork (plan D14). `update = none` keeps it out of
	# `git submodule update --init --recursive` / tools/install.sh so the public
	# clone works; build_cpu_baseline.sh initialises it explicitly (needs access).
	update = none
