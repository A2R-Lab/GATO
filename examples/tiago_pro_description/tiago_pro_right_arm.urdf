<!-- Modified (Apache-2.0, section 4b) by Felix Muehlenberend: derived from PAL's TIAGo Pro
     simulator URDF (tiago_pro_description) as the reduced right arm used for MPC with GATO
     (gato_tiago f169a20, tiago.arm_urdf): fixed root torso_lift_link, the seven right-arm joints
     in native coordinates (joint 6 turns about -z), the gripper's links lumped into
     arm_right_tool_link at zero gripper posture, and a massless grasp frame. Visual and
     collision geometry removed. The joints' <dynamics> carry Coulomb friction (friction, Nm)
     and viscous damping (damping, Nm s/rad) fitted from real single-joint chirps on 2026-10-30,
     not PAL's values. The reflected armature is not representable in URDF; see
     tiago_pro_right_arm_parameters.csv. -->
<!-- Modified by the GATO authors (Apache-2.0, section 4b): PAL's collision meshes of the seven arm links
     (pal_sea_arm_description, arm_tiago_pro, spherical wrist) added as <collision> at the link origin.
     See README.md in this folder. -->
<robot name="tiago_pro_right_arm">
  <link name="torso_lift_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="3.24266045177967" />
      <inertia ixx="0.0295369723560087" ixy="-7.85101789883696E-07" ixz="-8.58576921315497E-05" iyy="0.0170989395656347" iyz="-8.17944373020342E-06" izz="0.0290055792681799" />
    </inertial>
  </link>
  <link name="arm_right_1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00476 0.01532 0.15274" />
      <mass value="1.21459" />
      <inertia ixx="0.00434" ixy="0.00004" ixz="0.00016" iyy="0.00421" iyz="-0.00051" izz="0.00121" />
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/arm_1_link_collision.stl" />
      </geometry>
    </collision>
  </link>
  <link name="arm_right_2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.01715 -0.11231 -0.03000" />
      <mass value="1.13101" />
