    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/arm_2_link_collision.stl" />
      </geometry>
    </collision>
  </link>
  <link name="arm_right_3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.01530 -0.00471 0.13242" />
      <mass value="1.21628" />
      <inertia ixx="0.00425" ixy="-0.00004" ixz="-0.00051" iyy="0.00437" iyz="-0.00015" izz="0.00121" />
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
