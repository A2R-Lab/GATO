      <mass value="0.73294020568391793" />
      <inertia ixx="0.0014180140239798678" ixy="-2.1090342807282663e-07" ixz="2.9128128307686125e-07" iyy="0.0011161263916423067" iyz="2.5287741519460123e-07" izz="0.00065159379068213761" />
    </inertial>
  </link>
  <joint name="arm_right_1_joint" type="revolute">
    <origin rpy="-2.0679 -0.0 -1.9198899999999999" xyz="0.08976 -0.15918 -0.092008" />
    <parent link="torso_lift_link" />
    <child link="arm_right_1_link" />
